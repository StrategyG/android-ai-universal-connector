# Local MCP stdio requires no API credentials.
# Never put real tokens, passwords, OAuth client secrets, or refresh tokens here.
# Configure gateway values through your deployment platform's secret/environment manager.
AIC_ENV=development
AIC_LOG_LEVEL=INFO

# Required only for the remote OAuth-protected Streamable HTTP gateway.
# Leave blank until an OAuth provider and exact public MCP URL are configured.
AIC_MCP_ISSUER_URL=
AIC_MCP_RESOURCE_URL=
AIC_OAUTH_INTROSPECTION_URL=
AIC_OAUTH_CLIENT_ID=
AIC_OAUTH_CLIENT_SECRET=
AIC_MCP_REQUIRED_SCOPES=aic:read
AIC_MCP_ALLOWED_ORIGINS=
AIC_MCP_BIND_HOST=127.0.0.1
AIC_MCP_PORT=8000
AIC_TRUSTED_PROXY_IPS=127.0.0.1,::1
